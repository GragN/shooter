<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.9.4" />
    <Compile Include="Program.cs" />
    <Compile Include="ConcreteTests.cs" />
    <Compile Include="WeaponTests.cs" />
    <Compile Include="../Ballistics/*.cs" Link="Ballistics/%(Filename)%(Extension)" />
    <Compile Include="../Destruction/*.cs" Link="Destruction/%(Filename)%(Extension)" />
    <Compile Include="../Rendering/SteelPlateGeometry.cs" Link="SteelPlateGeometry.cs" />
    <Compile Include="../Rendering/ConcreteMeshGeometry.cs" Link="ConcreteMeshGeometry.cs" />
  </ItemGroup>
</Project>
